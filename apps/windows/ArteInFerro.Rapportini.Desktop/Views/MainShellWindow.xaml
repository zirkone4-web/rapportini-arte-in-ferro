<Window x:Class="ArteInFerro.Rapportini.Desktop.Views.MainShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arte In Ferro Lascari · Gestionale"
        Width="1500" Height="900" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8F0F7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="42" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#234D70" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompactAction" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="3" />
        </Style>

        <Style x:Key="ModernGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="AlternatingRowBackground" Value="#F7FAFC"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        </Style>

        <Style x:Key="ModernRow" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="54"/>
            <Setter Property="BorderBrush" Value="#E5EBF0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EDF5FB"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCECF8"/>
                    <Setter Property="Foreground" Value="#102F49"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="ModernHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EFF4F8"/>
            <Setter Property="Foreground" Value="#415665"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,11"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#D9E2E9"/>
        </Style>

        <Style x:Key="RowActionButton" TargetType="Button">
            <Setter Property="Content" Value="AZIONI  ▾"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="#E1EEF7"/>
            <Setter Property="Foreground" Value="#12385B"/>
            <Setter Property="BorderBrush" Value="#BFD4E4"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- MENU LATERALE -->
        <Border Grid.Column="0" Background="{StaticResource IronBlueDark}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="92" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="62" />
                </Grid.RowDefinitions>

                <Border Margin="14,14,14,10" Background="White" CornerRadius="10" Padding="10">
                    <Image Source="/Assets/logo_arte_in_ferro.png" Stretch="Uniform" />
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="GESTIONE" Foreground="#8FA9BE" FontSize="11"
                                   FontWeight="Bold" Margin="22,12,0,6" />
                        <Button Style="{StaticResource SidebarButton}" Content="Dashboard"
                                Click="DashboardClick" />
                        <Button Style="{StaticResource SidebarButton}" Content="Pianificazione lavori"
                                Click="PlanningClick" />
                        <Button Style="{StaticResource SidebarButton}" Content="Rapportini"
                                Click="ReportsClick" />
                        <Button Style="{StaticResource SidebarButton}" Content="Presenze"
                                Click="AttendanceClick" />

                        <TextBlock Text="ANAGRAFICHE" Foreground="#8FA9BE" FontSize="11"
                                   FontWeight="Bold" Margin="22,18,0,6" />
                        <Button Style="{StaticResource SidebarButton}" Content="Clienti e cantieri"
                                Click="MasterDataClick" />
                        <Button Style="{StaticResource SidebarButton}" Content="Dipendenti e accessi"
                                Click="EmployeeAccessClick" />
                        <Button Style="{StaticResource SidebarButton}" Content="Corsi, visite e patentini"
                                Click="EmployeeDocumentsClick" />

                        <TextBlock Text="OPERATIVITÀ" Foreground="#8FA9BE" FontSize="11"
                                   FontWeight="Bold" Margin="22,18,0,6" />
                        <Button Style="{StaticResource SidebarButton}" Content="Comunicazioni"
                                Click="CommunicationsClick" />
                        <Button Style="{StaticResource SidebarButton}" Content="Mezzi e assicurazioni"
                                Click="FleetClick" />
                        <Button Style="{StaticResource SidebarButton}" Content="Carburante e anomalie"
                                Click="OperationsClick" />
                        <Button Style="{StaticResource SidebarButton}" Content="Scadenziario"
                                Click="DeadlinesClick" />

                        <TextBlock Text="AZIENDA" Foreground="#8FA9BE" FontSize="11"
                                   FontWeight="Bold" Margin="22,18,0,6" />
                        <Button Style="{StaticResource SidebarButton}" Content="Dati azienda e contatti"
                                Click="CompanySettingsClick" />
                        <Button Style="{StaticResource SidebarButton}" Content="Certificazioni azienda"
                                Click="CompanyCertificationsClick" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="18,7">
                    <TextBlock Text="Arte In Ferro Lascari" Foreground="#B8C9D8"
                               FontSize="12" />
                    <TextBlock Text="Nuovo gestionale · fase 1" Foreground="#6F8DA5"
                               FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- AREA PRINCIPALE -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="0,0,0,1" Padding="22,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Dashboard"
                                   FontSize="24" FontWeight="SemiBold" Foreground="#17212B" />
                        <TextBlock Text="Centro operativo Arte In Ferro Lascari"
                                   Foreground="#647483" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="100" Height="5" Margin="8"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Aggiorna" Command="{Binding LoadCommand}"
                                Style="{StaticResource CompactAction}" />
                        <Border Background="#E8F0F7" CornerRadius="18" Padding="14,7" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Amministratore" FontSize="10" Foreground="#657989" />
                                <TextBlock Text="{Binding AdminName}" FontWeight="SemiBold"
                                           Foreground="{StaticResource IronBlue}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18">

                <!-- DASHBOARD -->
                <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Situazione generale" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Le informazioni principali sono raccolte in un'unica schermata."
                                   Foreground="#647483" Margin="0,3,0,14" />

                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Rapportini caricati" Foreground="#687987" />
                                    <TextBlock Text="{Binding Reports.Count}" FontSize="32"
                                               FontWeight="Bold" Foreground="{StaticResource IronBlue}" />
                                    <Button Content="Apri rapportini" Click="ReportsClick"
                                            HorizontalAlignment="Left" Style="{StaticResource CompactAction}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Presenze disponibili" Foreground="#687987" />
                                    <TextBlock Text="{Binding Attendance.Count}" FontSize="32"
                                               FontWeight="Bold" Foreground="#1F7A4D" />
                                    <Button Content="Gestisci presenze" Click="AttendanceClick"
                                            HorizontalAlignment="Left" Style="{StaticResource CompactAction}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Scadenze registrate" Foreground="#687987" />
                                    <TextBlock Text="{Binding Deadlines.Count}" FontSize="32"
                                               FontWeight="Bold" Foreground="#B45C20" />
                                    <Button Content="Apri scadenziario" Click="DeadlinesClick"
                                            HorizontalAlignment="Left" Style="{StaticResource CompactAction}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Ultimi rapportini" FontSize="17"
                                               FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding Reports}"
                                              SelectedItem="{Binding SelectedReport}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              RowHeight="36" MaxHeight="390"
                                              MouseDoubleClick="ReportDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Data"
                                                Binding="{Binding StartAt.LocalDateTime, StringFormat=dd/MM HH:mm}"
                                                Width="115" />
                                            <DataGridTextColumn Header="Dipendente"
                                                Binding="{Binding EmployeeName}" Width="160" />
                                            <DataGridTextColumn Header="Cliente"
                                                Binding="{Binding ClientName}" Width="190" />
                                            <DataGridTextColumn Header="Stato"
                                                Binding="{Binding Status}" Width="95" />
                                            <DataGridTextColumn Header="Descrizione"
                                                Binding="{Binding Description}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Azioni rapide" FontSize="17"
                                               FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <Button Content="Pianifica lavoro" Click="NewPlanningClick"
                                            HorizontalContentAlignment="Left" />
                                    <Button Content="Nuovo rapportino" Click="NewReportClick"
                                            HorizontalContentAlignment="Left" />
                                    <Button Content="Nuovo dipendente" Click="NewEmployeeClick"
                                            HorizontalContentAlignment="Left" />
                                    <Button Content="Clienti e cantieri" Click="MasterDataClick"
                                            HorizontalContentAlignment="Left" />
                                    <Button Content="Invia comunicazione" Click="CommunicationsClick"
                                            HorizontalContentAlignment="Left" />
                                    <Button Content="Gestisci mezzi" Click="FleetClick"
                                            HorizontalContentAlignment="Left" />
                                    <Button Content="Dati azienda" Click="CompanySettingsClick"
                                            HorizontalContentAlignment="Left" />
                                    <Button Content="Archivio completo Excel"
                                            Command="{Binding ExportFullArchiveExcelCommand}"
                                            HorizontalContentAlignment="Left" />
                                    <Button Content="Archivio completo PDF"
                                            Command="{Binding ExportFullArchivePdfCommand}"
                                            HorizontalContentAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- RAPPORTINI -->
                <Grid x:Name="ReportsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="135" />
                                <ColumnDefinition Width="135" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Dal" FontWeight="SemiBold" />
                                <DatePicker SelectedDate="{Binding DateFrom}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Al" FontWeight="SemiBold" />
                                <DatePicker SelectedDate="{Binding DateTo}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Dipendente" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding Employees}"
                                          SelectedItem="{Binding SelectedEmployee}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="Cliente" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding Clients}"
                                          SelectedItem="{Binding SelectedClient}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                <TextBlock Text="Stato" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding Statuses}"
                                          SelectedItem="{Binding SelectedStatus}" />
                            </StackPanel>
                            <Button Grid.Column="5" Content="Applica"
                                    Command="{Binding ApplyFiltersCommand}"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource IronBlue}" Foreground="White" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Nuovo rapportino" Click="NewReportClick"
                                Background="#CFE7FF" />
                        <Button Content="Esporta Excel" Command="{Binding ExportExcelCommand}" />
                        <Button Content="PDF rapportino selezionato" Command="{Binding ExportPdfCommand}" />
                        <Button Content="PDF della lista visualizzata"
                                Command="{Binding ExportVisibleReportsPdfCommand}" Background="#DDF3E5" />
                    </StackPanel>

                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="4">
                        <DataGrid ItemsSource="{Binding Reports}"
                                  Style="{StaticResource ModernGrid}"
                                  RowStyle="{StaticResource ModernRow}"
                                  CellStyle="{StaticResource ModernCell}"
                                  ColumnHeaderStyle="{StaticResource ModernHeader}"
                                  SelectedItem="{Binding SelectedReport}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  CanUserSortColumns="True" CanUserReorderColumns="True"
                                  MouseDoubleClick="ReportDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data e ora"
                                    Binding="{Binding StartAt.LocalDateTime, StringFormat=ddd dd/MM · HH:mm}"
                                    Width="155" />
                                <DataGridTextColumn Header="Dipendente"
                                    Binding="{Binding EmployeeName}" Width="205" />
                                <DataGridTextColumn Header="Cliente"
                                    Binding="{Binding ClientName}" Width="*" />
                                <DataGridTextColumn Header="Stato"
                                    Binding="{Binding StatusLabel}" Width="120" />
                                <DataGridTemplateColumn Header="Azioni" Width="112">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowActionButton}"
                                                    ToolTip="Azioni rapportino" Click="RowMenuButtonClick">
                                                <Button.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="Apri e modifica" Click="OpenReportMenuClick"/>
                                                        <MenuItem Header="Esporta questo rapportino in PDF" Click="ExportReportMenuClick"/>
                                                        <Separator/>
                                                        <MenuItem Header="Cancella rapportino" Foreground="#B42318"
                                                                  Click="DeleteReportMenuClick"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- PIANIFICAZIONE LAVORI -->
                <Grid x:Name="PlanningPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Agenda lavori" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Apri ogni rapportino e usa il menu azioni senza cambiare schermata."
                                       Foreground="#647483" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="+ NUOVA PIANIFICAZIONE"
                                Click="NewPlanningClick" Background="{StaticResource IronBlue}"
                                Foreground="White"/>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="GIORNO" Click="PlanningDayClick"/>
                                <Button Content="SETTIMANA" Click="PlanningWeekClick"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="‹" Click="PlanningPreviousClick" FontSize="20"/>
                                <StackPanel Margin="18,0">
                                    <TextBlock Text="{Binding PlanningPeriodLabel}" FontSize="17"
                                               FontWeight="Bold" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding PlanningViewLabel}" Foreground="#647483"
                                               TextAlignment="Center"/>
                                </StackPanel>
                                <Button Content="›" Click="PlanningNextClick" FontSize="20"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="OGGI" Click="PlanningTodayClick"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="4">
                        <DataGrid ItemsSource="{Binding PlannedReports}"
                                  Style="{StaticResource ModernGrid}"
                                  RowStyle="{StaticResource ModernRow}"
                                  CellStyle="{StaticResource ModernCell}"
                                  ColumnHeaderStyle="{StaticResource ModernHeader}"
                                  SelectedItem="{Binding SelectedReport}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  MouseDoubleClick="ReportDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Giorno"
                                    Binding="{Binding StartAt.LocalDateTime, StringFormat=ddd dd/MM}" Width="105"/>
                                <DataGridTextColumn Header="Orario"
                                    Binding="{Binding StartAt.LocalDateTime, StringFormat=HH:mm}" Width="75"/>
                                <DataGridTextColumn Header="Responsabile"
                                    Binding="{Binding EmployeeName}" Width="175"/>
                                <DataGridTextColumn Header="Cliente"
                                    Binding="{Binding ClientName}" Width="220"/>
                                <DataGridTextColumn Header="Attività"
                                    Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Stato"
                                    Binding="{Binding StatusLabel}" Width="105"/>
                                <DataGridTemplateColumn Header="Azioni" Width="112">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowActionButton}"
                                                    ToolTip="Azioni pianificazione" Click="RowMenuButtonClick">
                                                <Button.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="Apri e modifica" Click="OpenReportMenuClick"/>
                                                        <MenuItem Header="Esporta in PDF" Click="ExportReportMenuClick"/>
                                                        <MenuItem Header="Annulla pianificazione" Click="CancelPlanningMenuClick"/>
                                                        <Separator/>
                                                        <MenuItem Header="Cancella definitivamente" Foreground="#B42318"
                                                                  Click="DeleteReportMenuClick"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#E4EAF0" Padding="16,7">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#455867" />
            </Border>
        </Grid>

        <Grid x:Name="IntroOverlay" Grid.ColumnSpan="2" Panel.ZIndex="100"
              Visibility="Collapsed"
              Background="#020914" MouseLeftButtonDown="SkipIntroClick">
            <Image x:Name="IntroBackground" Source="/Assets/wormhole_intro.png"
                   Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.22" ScaleY="1.22"/>
                </Image.RenderTransform>
            </Image>
            <Border x:Name="IntroLogo" Background="#F2FFFFFF" CornerRadius="18"
                    Padding="26,18" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.55" ScaleY="0.55"/>
                </Border.RenderTransform>
                <Image Source="/Assets/logo_arte_in_ferro.png" Width="390" Height="150"
                       Stretch="Uniform"/>
            </Border>
            <TextBlock Text="Clicca per saltare" Foreground="#CCFFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,28" FontSize="12"/>
        </Grid>
    </Grid>
</Window>
