<Window x:Class="ArteInFerro.Rapportini.Desktop.Views.IntroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        WindowState="Maximized" Topmost="True" Background="#020914"
        ShowInTaskbar="False" MouseLeftButtonDown="SkipIntroClick">
    <Grid ClipToBounds="True">
        <Image x:Name="IntroBackground" Source="/Assets/wormhole_intro.png"
               Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
            </Image.RenderTransform>
        </Image>
        <Border Background="#50000000"/>
        <Border x:Name="IntroLogo" Background="#F5FFFFFF" CornerRadius="22"
                Padding="24" Width="480" HorizontalAlignment="Center"
                VerticalAlignment="Center" Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.25" ScaleY="0.25"/>
            </Border.RenderTransform>
            <Image Source="/Assets/logo_arte_in_ferro.png" Stretch="Uniform"/>
        </Border>
        <TextBlock Text="ARTE IN FERRO" Foreground="White" FontSize="18"
                   FontWeight="SemiBold" CharacterSpacing="180"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,70"/>
        <TextBlock Text="Clicca per saltare" Foreground="#DCEEFF" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,35"/>
    </Grid>
</Window>
